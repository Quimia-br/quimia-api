meta {
  name: 02 - Cadastro com senha fraca
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "nome": "Sem Numero",
    "email": "fraca@example.com",
    "senha": "somenteletras"
  }
}

tests {
  test("exige letra e número", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().detail).to.equal("weak_password");
  });
}

docs {
  A senha precisa de letras e números.
  Respostas: ver o teste da requisição.
}
