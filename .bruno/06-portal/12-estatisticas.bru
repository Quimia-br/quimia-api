meta {
  name: 12 - Estatísticas
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/empresas/me/estatisticas
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{empresaAccessToken}}
}

tests {
  test("traz os cards", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("cards");
  });
}

docs {
  Cards da tela Estatísticas (produtos em estantes e taxa de sucesso das misturas). `q` filtra pelo
  título, sem acento nem caixa (até 100 caracteres).
  Respostas: 200, 400 termo_muito_longo, 403 empresa_inativa.
}
