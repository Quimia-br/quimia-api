meta {
  name: 02 - Salvar ponto
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v1/pontos/salvos/{{pontoId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

tests {
  test("salva o ponto", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("salvoEm");
  });
}

docs {
  Salva o ponto para o usuário e devolve os campos de 01 mais `salvoEm`. Salvar de novo não é erro e
  mantém a data original.
  Antes: 01.
  Respostas: 200, 400 parametro_invalido, 404 ponto_nao_encontrado (inexistente ou desativado).
}
