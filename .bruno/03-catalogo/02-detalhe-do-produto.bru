meta {
  name: 02 - Detalhe do produto
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/produtos/{{produtoId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

tests {
  test("traz a marca", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().marca).to.have.property("nome");
  });
}

docs {
  Um produto com a marca e a logo.
  Antes: 01.
  Respostas: 200, 404 produto_nao_encontrado (inexistente ou oculto).
}
