meta {
  name: 01 - Meu perfil
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/usuarios/me
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

tests {
  test("retorna o perfil", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().nivelAcesso).to.equal("USUARIO");
  });
}

docs {
  Perfil do usuário logado.
  Antes: `00 / 02`.
  Respostas: 200, 401, 403 (token de empresa).
}
