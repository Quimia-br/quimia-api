meta {
  name: 13 - Reset Password
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "resetToken": "{{recoveryResetToken}}",
    "novaSenha": "{{recoveryPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar("userPassword", bru.getVar("recoveryPassword"));
    bru.setVar("recoveryResetToken", "");
  }
}

tests {
  test("consumes the reset token without returning the new password", function () {
    expect(res.getStatus()).to.equal(204);
    expect(String(res.getBody() || "")).to.not.contain(bru.getVar("recoveryPassword"));
  });
}

docs {
  Consumes the reset token once, changes the password, clears login blocking and revokes active refresh tokens.
}
