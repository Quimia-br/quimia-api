meta {
  name: 06 - Get Me
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/usuarios/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

tests {
  test("returns the authenticated profile", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("userId"));
    expect(res.getBody().email).to.equal(bru.getVar("userEmail"));
    expect(res.getBody().nivelAcesso).to.equal("USUARIO");
  });
}
