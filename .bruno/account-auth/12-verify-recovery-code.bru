meta {
  name: 12 - Verify Recovery Code
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/auth/verify-recovery-code
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "code": "{{recoveryCode}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body && body.resetToken) {
    bru.setVar("recoveryResetToken", body.resetToken);
    bru.setVar("recoveryCode", "");
  }
}

tests {
  test("exchanges a valid code for a short-lived reset token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().resetToken).to.be.a("string").and.not.be.empty;
    expect(res.getBody().expiresIn).to.equal(600);
  });
}

docs {
  Enter the eight-digit code received by email in recoveryCode before running this request.
}
