meta {
  name: 02 - Login Before Verification
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/problem+json
}

body:json {
  {
    "email": "{{userEmail}}",
    "senha": "{{userPassword}}"
  }
}

tests {
  test("blocks an unverified account", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().detail).to.equal("email_not_verified");
  });
}

docs {
  Proves that a correct password is insufficient before email verification.
}
