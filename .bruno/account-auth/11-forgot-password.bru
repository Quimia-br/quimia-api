meta {
  name: 11 - Forgot Password
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{userEmail}}"
  }
}

tests {
  test("returns the anti-enumeration response", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody()).to.deep.equal({});
  });
}

docs {
  Sends a recovery code only for an existing account. With the default noop sender, no email is delivered.
}
