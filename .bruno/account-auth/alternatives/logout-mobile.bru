meta {
  name: Logout Mobile - Body Transport
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/mobile/logout
  body: json
  auth: bearer
}

auth:bearer {
  token: {{mobileAccessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{mobileRefreshToken}}"
  }
}

tests {
  test("revokes a refresh supplied in the body", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Clear Bruno cookies first; a web refresh cookie on a mobile route is rejected.
}
