meta {
  name: E06 - Forgot Password Empresa
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/empresas/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{empresaEmail}}"
  }
}

tests {
  test("responde 202 genérico", function () { expect(res.getStatus()).to.equal(202); });
}

docs {
  Envia um link `APP_AUTH_EMPRESA_RESET_URL?token=…` válido por 24h. Copie o token do link para `empresaResetToken`.
}
