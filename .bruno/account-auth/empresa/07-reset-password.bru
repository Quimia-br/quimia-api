meta {
  name: E07 - Reset Password Empresa
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/empresas/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "resetToken": "{{empresaResetToken}}",
    "novaSenha": "{{recoveryPassword}}"
  }
}

tests {
  test("redefine a senha", function () { expect(res.getStatus()).to.equal(204); });
}
