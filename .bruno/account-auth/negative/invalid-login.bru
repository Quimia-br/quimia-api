meta {
  name: Invalid Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/mobile/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/problem+json
}

body:json {
  {
    "email": "{{userEmail}}",
    "senha": "SenhaErrada123"
  }
}

tests {
  test("401 genérico", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().detail).to.equal("invalid_credentials");
  });
}
