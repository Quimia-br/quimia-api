meta {
  name: Refresh Cookie Without CSRF
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: none
  auth: none
}

headers {
  Cookie: quimia_rt={{refreshToken}}
  Accept: application/problem+json
}

tests {
  test("rejects a cookie refresh without double-submit CSRF", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().detail).to.equal("csrf_required");
  });
}
