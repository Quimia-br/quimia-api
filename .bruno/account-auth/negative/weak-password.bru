meta {
  name: Weak Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/problem+json
}

body:json {
  {
    "nome": "Sem Numero",
    "email": "weak.{{userEmail}}",
    "senha": "somenteletras"
  }
}

tests {
  test("exige letra e número", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().detail).to.equal("weak_password");
  });
}
