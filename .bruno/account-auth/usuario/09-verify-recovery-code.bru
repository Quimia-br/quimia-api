meta {
  name: U09 - Verify Recovery Code
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/verify-recovery-code
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "code": "{{recoveryCode}}",
    "challengeToken": "{{challengeToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body && body.resetToken) { bru.setVar("recoveryResetToken", body.resetToken); }
}

tests {
  test("troca o código por um resetToken", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().expiresIn).to.equal(600);
  });
}

docs {
  Preencha `recoveryCode` com o código de 4 dígitos recebido. Cinco erros bloqueiam a recuperação desse email por 1 hora.
}
