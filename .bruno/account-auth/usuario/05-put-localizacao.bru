meta {
  name: U05 - Replace Localizacao
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/usuarios/me/localizacao
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "cep": "01310100",
    "estado": "sp",
    "rua": "Av. Paulista",
    "numero": 1000
  }
}

tests {
  test("substitui o endereço inteiro e normaliza CEP/UF", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().cep).to.equal("01310-100");
    expect(res.getBody().estado).to.equal("SP");
  });
}
