meta {
  name: U08 - Forgot Password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{userEmail}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 202 && body && body.challengeToken) { bru.setVar("challengeToken", body.challengeToken); }
}

tests {
  test("devolve desafio genérico", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody().challengeToken).to.be.a("string").and.not.be.empty;
    expect(res.getBody().expiresIn).to.equal(900);
  });
}

docs {
  Mesmo formato para conta existente ou não. O código de 4 dígitos chega por email (exige Resend configurado).
}
