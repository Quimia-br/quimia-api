meta {
  name: U07 - Mobile Refresh
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/mobile/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body && body.refreshToken) {
    bru.setVar("accessToken", body.accessToken);
    bru.setVar("refreshToken", body.refreshToken);
  }
}

tests {
  test("emite novos tokens", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().accessToken).to.be.a("string").and.not.be.empty;
  });
}

docs {
  Sessão sem estado: o refresh anterior continua válido até expirar ou até a senha mudar.
}
