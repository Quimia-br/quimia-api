meta {
  name: U10 - Reset Password
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "resetToken": "{{recoveryResetToken}}",
    "novaSenha": "{{recoveryPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 204) { bru.setVar("userPassword", bru.getVar("recoveryPassword")); }
}

tests {
  test("redefine a senha", function () { expect(res.getStatus()).to.equal(204); });
}

docs {
  Invalida os refresh tokens emitidos antes e o próprio resetToken.
}
