meta {
  name: 03 - Confirmar código (usuário)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/verify-recovery-code
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{recoveryEmail}}",
    "code": "{{recoveryCode}}",
    "challengeToken": "{{challengeToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body && body.resetToken) { bru.setVar("recoveryResetToken", body.resetToken); }
}

tests {
  test("troca o código por um resetToken", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().expiresIn).to.equal(600);
  });
}

docs {
  Cole o código recebido por email em `recoveryCode`, no ambiente. Cinco erros bloqueiam a recuperação desse email por 1 hora.
  Antes: 02.
  Respostas: 200, 400 invalid_recovery_code.
}
