meta {
  name: PT03 - Alterar Produto
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/empresas/me/produtos/{{portalProdutoId}}
  body: multipartForm
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{empresaAccessToken}}
}

body:multipart-form {
  nome: Limpa Vidros Portal Alterado
  ~imagem: @file(imagem-produto.png)
}

tests {
  test("altera o produto exclusivo da empresa", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Campos ausentes mantêm o valor. Só altera se a empresa for a única com vínculo ativo
  (senão 409 `produto_compartilhado`). Com `imagem`, troca a foto e apaga a anterior do Cloudinary.
}
