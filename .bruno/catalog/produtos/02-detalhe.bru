meta {
  name: P02 - Detalhe do Produto
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/produtos/{{produtoId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

tests {
  test("traz o produto com a marca", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().marca).to.have.property("logoUrl");
  });
}

docs {
  `produtoId` é preenchido por P01 ou P03. Produto oculto responde 404 `produto_nao_encontrado`.
}
