meta {
  name: E03 - Remover da Estante
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/estante/produtos/{{produtoId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("remove (idempotente)", function () { expect(res.getStatus()).to.equal(204); });
}

docs {
  Remover um produto que não está na estante também responde 204. O histórico de
  misturas do produto será apagado pelo módulo de misturas (ainda não implementado).
}
