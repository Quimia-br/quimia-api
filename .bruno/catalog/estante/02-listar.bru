meta {
  name: E02 - Minha Estante
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/estante/produtos?q=&page=0&size=20
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

tests {
  test("lista os produtos guardados", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("itens");
  });
}

docs {
  Mesmo formato do catálogo. Produtos que a empresa desativou depois de guardados continuam aparecendo.
}
