meta {
  name: A03 - Register Empresa
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/empresas/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "nome": "Empresa Catalogo",
    "cnpj": "{{empresaCnpj}}",
    "email": "{{empresaEmail}}",
    "senha": "{{empresaPassword}}"
  }
}

script:pre-request {
  bru.setVar("empresaEmail", `bruno.catalogo.empresa.${Date.now()}@example.com`);
}

tests {
  test("cria a empresa", function () { expect(res.getStatus()).to.equal(201); });
}

docs {
  O CNPJ é único: troque `empresaCnpj` antes de repetir no mesmo banco.
}
