meta {
  name: A04 - Login Empresa
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/empresas/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{empresaEmail}}",
    "senha": "{{empresaPassword}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body && body.accessToken) {
    bru.setVar("empresaAccessToken", body.accessToken);
  }
}

tests {
  test("autentica a empresa", function () { expect(res.getStatus()).to.equal(200); });
}
