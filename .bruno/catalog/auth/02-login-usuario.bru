meta {
  name: A02 - Login Usuario
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/mobile/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "senha": "{{userPassword}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body && body.accessToken) {
    bru.setVar("accessToken", body.accessToken);
  }
}

tests {
  test("autentica o usuário", function () { expect(res.getStatus()).to.equal(200); });
}
