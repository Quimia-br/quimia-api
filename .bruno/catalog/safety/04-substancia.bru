meta {
  name: S04 - Detalhe da Substância
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/substancias/{{substanciaId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

tests {
  test("traz sinônimos e classes", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("sinonimos");
    expect(res.getBody()).to.have.property("classes");
  });
}

docs {
  Rode antes `S02` para preencher `substanciaId`. 404 `substancia_nao_encontrada` se não existir.
}
