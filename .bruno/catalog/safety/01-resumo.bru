meta {
  name: S01 - Resumo Simplificado do Rótulo
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/estante/produtos/{{produtoId}}/resumo-simplificado
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

tests {
  test("lê o resumo do produto da estante", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("resumo");
  });
}

docs {
  Só leitura: o texto vem de `fds.resumo_simplificado` da FDS ativa mais recente. `resumo`
  nulo quando o produto não tem FDS ou texto. 404 `produto_nao_esta_na_estante` se o produto
  não está na estante do usuário (guarde-o antes com `estante/01-guardar`).
}
