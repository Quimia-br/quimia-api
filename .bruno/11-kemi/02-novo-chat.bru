meta {
  name: 02 - Novo chat
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/chat/sessoes/{{sessaoKemi}}/encerrar
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

tests {
  test("a conversa anterior foi resumida (rode a 01 antes)", function () {
    expect(res.getStatus()).to.equal(200);
    expect(["resumida", "ja_resumida", "sem_turnos"]).to.include(res.getBody().situacao);
  });
}

docs {
  Usuário clicou em "novo chat": o agente resume a conversa `sessaoKemi` e guarda o resumo; o próximo envio sem `sessaoId` abre outra. Repetir não gera outro resumo (`ja_resumida`).
  Precisa de `QUIMIA_AGENTE_URL` na API. Não conta no limite de mensagens.
  Respostas: 200, 400 sessao_invalida, 502 agente_falhou, 503 agente_indisponivel, 504 agente_timeout.
}
