meta {
  name: 02 - Listar estante
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/estante/produtos?page=0&size=20
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body.itens.length > 1) {
    bru.setVar("produtoId", body.itens[0].id);
    bru.setVar("outroProdutoId", body.itens[1].id);
  }
}

tests {
  test("lista a estante", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("totalItens");
  });
}

docs {
  Produtos guardados, inclusive os que saíram do catálogo. Aceita `q`, `page`, `size` e `ordem`
  (`alfabetica`, padrão; `recentes` ou `antigos`, pela data em que o produto foi guardado).
  Antes: 01.
  Com dois produtos ou mais, guarda `produtoId` e `outroProdutoId` (usados em 08 Cômodos e 09 Misturas).
  Respostas: 200, 400.
}
