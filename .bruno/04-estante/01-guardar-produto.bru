meta {
  name: 01 - Guardar produto
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/estante/produtos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "produtoIds": [{{produtoId}}]
  }
}

tests {
  test("informa o resultado de cada produto", function () {
    expect(res.getStatus()).to.equal(200);
    expect(["adicionado", "ja_na_estante", "nao_encontrado"]).to.include(res.getBody().itens[0].status);
  });
}

docs {
  Guarda um ou mais produtos (até 50). Para vários, edite a lista: `[1, 2, 3]`.
  Antes: `03 - Catálogo / 01`.
  Respostas: 200 com `status` por item (adicionado, ja_na_estante, nao_encontrado), 400.
}
