meta {
  name: 01 - Criar cômodo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/comodos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "nome": "Banheiro",
    "icone": "banheira",
    "produtoIds": [{{produtoId}}, {{outroProdutoId}}]
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("comodoId", res.getBody().id);
  }
}

tests {
  test("cria o cômodo com a avaliação de risco", function () {
    expect(res.getStatus()).to.equal(201);
    expect(["seguro", "atencao", "critico", "nao_avaliado"]).to.include(res.getBody().avaliacao.status);
  });
}

docs {
  Cria o cômodo com 2 a 20 produtos da estante e devolve a avaliação de risco de todos os pares
  (seguro, atencao, critico ou nao_avaliado) e os pares incompatíveis, do mais grave ao menos grave.
  `icone`: letras minúsculas, dígitos, `_` e `-`. Um produto fica em no máximo um cômodo.
  Antes: `04 - Estante / 01` com dois produtos e `04 / 02` (guarda `produtoId` e `outroProdutoId`).
  Respostas: 201, 400 validation, 409 comodo_ja_existe ou produto_em_outro_comodo,
  422 comodo_produtos_insuficientes, comodo_produtos_demais ou produto_fora_da_estante.
}
